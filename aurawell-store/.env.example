# Copy this file to `.env` and fill in real values. Never commit `.env`.

# PostgreSQL connection string, e.g. postgresql://postgres:YOUR_PASSWORD@localhost:5432/aurawell?schema=public
DATABASE_URL=

# Public base URL of the store, e.g. https://yourdomain.com (dev: http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin panel runs on its own host. Dev: `npm run dev:admin` → http://localhost:3001
# Production: ADMIN_APP_URL=https://admin.yourdomain.com and ADMIN_HOSTS=admin.yourdomain.com
ADMIN_APP_URL=http://localhost:3001
# Comma-separated Host headers that should serve the admin panel (host[:port]).
ADMIN_HOSTS=localhost:3001,admin.localhost:3000

# Long random string (at least 32 characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

# Razorpay — https://dashboard.razorpay.com/app/keys (use test keys for development)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMTP for order emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# Used only by `npm run admin:create` to create the first admin account.
ADMIN_SEED_NAME=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
