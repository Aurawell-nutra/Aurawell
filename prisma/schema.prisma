// Aaurawell Nutra — PostgreSQL schema.
// All money values are stored as integers in the smallest currency unit (paise for INR)
// to avoid floating-point rounding errors. ₹599.00 is stored as 59900.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  OWNER
  ADMIN
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriberStatus {
  PENDING // signed up, waiting for email confirmation
  ACTIVE
  UNSUBSCRIBED
}

enum EmailStatus {
  NOT_SENT
  SENT
  FAILED
}

model AdminUser {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  role         AdminRole      @default(ADMIN)
  isActive     Boolean        @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
}

// Only a SHA-256 hash of the session token is stored; the raw token lives in an HTTP-only cookie.
model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  csrfToken String
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([adminId])
  @@index([expiresAt])
}

model Product {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String   @unique
  shortDescription  String
  description       String
  price             Int // paise
  compareAtPrice    Int? // paise
  currency          String   @default("INR")
  stockQuantity     Int      @default(0)
  sku               String?  @unique
  mainImage         String
  heroImage         String?
  galleryImages     String[]
  ingredients       Json // [{ name, quantity, unit }]
  benefits          Json // [{ icon, label }]
  usageInstructions String
  warnings          String
  storageInfo       String?
  category          String

  // Display fields used by the existing storefront design.
  subtitle     String?
  tagline      String?
  flavour      String?
  servingCount Int      @default(30)
  theme        String   @default("sage") // blush | sage | peach | rose
  scriptLines  String[]

  isActive    Boolean   @default(true)
  isFeatured  Boolean   @default(false)
  sortOrder   Int       @default(0)
  // Set when subscribers were emailed about this product, so they're never emailed twice.
  announcedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  orderItems OrderItem[]
  reviews    Review[]

  @@index([isActive, sortOrder])
  @@index([category])
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  // Idempotency key generated by the browser for one checkout attempt,
  // so a double-submitted checkout never creates two orders.
  checkoutKey String? @unique

  customerName  String
  customerEmail String
  customerPhone String
  addressLine1  String
  addressLine2  String?
  city          String
  state         String
  postalCode    String
  country       String

  subtotal       Int // paise
  discountAmount Int    @default(0)
  shippingAmount Int    @default(0)
  taxAmount      Int    @default(0)
  totalAmount    Int
  currency       String @default("INR")

  paymentStatus PaymentStatus @default(PENDING)
  orderStatus   OrderStatus   @default(PENDING)

  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique
  razorpaySignature String?

  paidAt        DateTime?
  stockDeducted Boolean     @default(false)
  emailStatus   EmailStatus @default(NOT_SENT)
  notes         String? // internal admin notes, never shown to customers

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@index([customerEmail])
  @@index([paymentStatus])
  @@index([orderStatus])
  @@index([createdAt])
}

// Product details are snapshotted so past orders stay accurate if a product changes later.
model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName  String
  productSku   String?
  productImage String
  quantity     Int
  unitPrice    Int // paise
  totalPrice   Int // paise

  @@index([orderId])
  @@index([productId])
}

model Review {
  id            String       @id @default(cuid())
  productId     String
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerName  String
  customerEmail String? // private — never returned by public APIs
  rating        Int
  title         String?
  comment       String
  status        ReviewStatus @default(PENDING)
  isFeatured    Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([productId, status])
  @@index([status, isFeatured])
  @@index([customerEmail, productId])
}

// Razorpay webhook event IDs already processed — makes webhook retries idempotent.
model WebhookEvent {
  id         String   @id // x-razorpay-event-id
  event      String
  receivedAt DateTime @default(now())
}

// Newsletter subscribers (double opt-in). Only a hash of the confirmation token is stored.
model Subscriber {
  id                String           @id @default(cuid())
  email             String           @unique
  status            SubscriberStatus @default(PENDING)
  confirmTokenHash  String?          @unique
  confirmExpiresAt  DateTime?
  unsubscribeToken  String           @unique // random, used in every email's unsubscribe link
  confirmedAt       DateTime?
  unsubscribedAt    DateTime?
  lastConfirmSentAt DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([status])
}
